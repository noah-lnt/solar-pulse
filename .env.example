# ─── PostgreSQL ───
POSTGRES_USER=solarpulse
POSTGRES_PASSWORD=solarpulse_secret
POSTGRES_DB=solarpulse
DATABASE_URL=postgresql://solarpulse:solarpulse_secret@postgres:5432/solarpulse

# ─── Auth ───
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
REGISTER_SECRET=change-me-code-inscription

# ─── Site ───
SITE_LATITUDE=48.8566
SITE_LONGITUDE=2.3522

# ─── Shelly Pro 3EM ───
SHELLY_IP=192.168.1.XX

# ─── Hoymiles Cloud ───
HOYMILES_API_URL=https://neapi.hoymiles.com
HOYMILES_PROXY_URL=
HOYMILES_EMAIL=
HOYMILES_PASSWORD=
HOYMILES_STATION_ID=

# ─── Victron (Venus OS) ───
VICTRON_VENUS_IP=192.168.1.XX
VICTRON_MQTT_PORT=1883

# ─── General ───
BACKEND_PORT=3001
WS_HEARTBEAT_MS=5000
DEMO_MODE=true

# ─── Traefik ───
TRAEFIK_HOST=solarpulse.example.com
